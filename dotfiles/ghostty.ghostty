# Oliver's Ghostty configuration (shared across macOS and Linux stations)
# Symlinked into ~/.config/ghostty/config.ghostty on each station.
# Ghostty reloads most settings after saving this file.
# Fully restart Ghostty after changing background opacity.

# Appearance
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-size = 21
background-opacity = 0.96
split-divider-color = #f38ba8

# Spacing
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true

# macOS window appearance (ignored on Linux)
macos-titlebar-style = transparent

# Terminal behavior
cursor-style = block
copy-on-select = true
confirm-close-surface = false

# Split panels
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = alt+w=close_surface

# Navigate split panels
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_right=goto_split:right

# Resize split panels
keybind = ctrl+alt+shift+arrow_left=resize_split:left,40
keybind = ctrl+alt+shift+arrow_down=resize_split:down,40
keybind = ctrl+alt+shift+arrow_up=resize_split:up,40
keybind = ctrl+alt+shift+arrow_right=resize_split:right,40
keybind = ctrl+alt+equal=equalize_splits

# Zoom a split (temporarily maximize the focused pane)
keybind = alt+z=toggle_split_zoom

# Scrollback and prompt navigation (relies on shell integration)
scrollback-limit = 10000000
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Reload this config without restarting
keybind = cmd+shift+r=reload_config

# macOS-only conveniences (cmd bindings are ignored on Linux)
# Quick drop-down terminal on a global hotkey
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
