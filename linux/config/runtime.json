{
  "docker": {
    "container_name": "forge-sql",
    "image": "mcr.microsoft.com/mssql/server:2022-latest",
    "host_port": 2022,
    "sql_user": "sa",
    "container_root": "/var/opt/mssql",
    "container_snapshots_path": "/var/opt/mssql/snapshots",
    "sqlcmd_path": "/opt/mssql-tools18/bin/sqlcmd"
  },
  "paths": {
    "sql_storage_root": "/data/sql/docker",
    "data_bind_path": "data",
    "restore_stage_path": "snapshots"
  },
  "restore": {
    "backup_source_paths": [
      "/data/sql",
      "/data/sql/snapshot",
      "/data/sql/snapshots"
    ]
  },
  "mounts": [
    {
      "title": "Ardis SQL backup share",
      "protocol": "smb",
      "source": "//portainer.ardis.eu/shared-files",
      "mountpoint": "/mnt/shared-files",
      "credentials_file": "~/.smbcredentials-ardis",
      "options": "vers=3.0,iocharset=utf8,file_mode=0644,dir_mode=0755"
    },
    {
      "title": "Hades work share",
      "protocol": "smb",
      "source": "//hadesw/shared",
      "mountpoint": "~/hades",
      "credentials_file": "~/.smbcredentials",
      "options": "vers=3.0,iocharset=utf8,file_mode=0644,dir_mode=0755,mfsymlinks"
    }
  ],
  "ardis": {
    "migrations_paths": [
      "/home/oliver/work/ardis-perform/Ardis.Migrations.Console",
      "/home/oliver/work/ardis-perform-230/Ardis.Migrations.Console"
    ],
    "migrations_library": "Ardis.Migrations.Console.dll"
  }
}
